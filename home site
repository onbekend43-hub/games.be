<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Game Hub — Volledige Platform (250 games)</title>
  <style>
    /* Basis styling - modern en cool voor 12-19 jaar */
    :root{
      --bg1:#0f1724; --bg2:#10243a; --accent:#ff4b6e; --card:#0e2338; --muted:#9fb3c8;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:Inter, Poppins, Arial, sans-serif;background:linear-gradient(180deg,var(--bg1),var(--bg2));color:#eaf6ff;}
    header{padding:18px 22px;border-bottom:1px solid rgba(255,255,255,0.04);display:flex;align-items:center;gap:12px;justify-content:space-between}
    .brand{display:flex;align-items:center;gap:12px}
    .logo{width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#6de0ff,#8b5cff);display:flex;align-items:center;justify-content:center;font-weight:800;color:#042;box-shadow:0 6px 20px rgba(0,0,0,0.6)}
    h1{font-size:20px;margin:0}

    .controls{display:flex;gap:12px;align-items:center}
    .search{padding:8px 12px;border-radius:10px;border:0;background:rgba(255,255,255,0.04);color:inherit;min-width:220px}
    .btn{background:var(--accent);border:0;padding:8px 12px;border-radius:10px;color:#fff;font-weight:700;cursor:pointer}
    .filters{display:flex;gap:10px;flex-wrap:wrap;padding:14px 22px}
    .chip{background:rgba(255,255,255,0.03);padding:8px 12px;border-radius:999px;cursor:pointer;border:1px solid rgba(255,255,255,0.03)}
    .chip.active{background:linear-gradient(90deg,#ff7aa2,#7be0ff);color:#042;font-weight:800}

    main{max-width:1200px;margin:18px auto;padding:0 18px}

    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px}
    .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.015));padding:10px;border-radius:12px;box-shadow:0 8px 30px rgba(0,0,0,0.6);cursor:pointer;transition:transform .18s,box-shadow .18s}
    .card:hover{transform:translateY(-8px);box-shadow:0 18px 40px rgba(0,0,0,0.6)}
    .thumb{width:100%;height:110px;border-radius:8px;object-fit:cover;background:#071426;display:block}
    .title{margin:8px 0 0 0;font-size:14px;font-weight:700;color:#ecf9ff}
    .meta{font-size:12px;color:var(--muted);margin-top:6px}

    .viewer{display:none;position:fixed;inset:0;background:linear-gradient(rgba(2,6,23,0.85),rgba(2,6,23,0.95));align-items:center;justify-content:center;padding:28px}
    .viewer.show{display:flex}
    .viewer-frame{width:92%;height:86%;background:#fff;border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
    .viewer-top{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:linear-gradient(90deg,#071426,#0b2b45);color:#fff}
    .viewer-iframe{flex:1;border:0;width:100%}
    .close{background:transparent;border:1px solid rgba(255,255,255,0.08);padding:8px 12px;border-radius:10px;color:#fff;cursor:pointer}

    .pager{display:flex;gap:8px;justify-content:center;padding:18px}
    .pageBtn{background:rgba(255,255,255,0.03);padding:8px 12px;border-radius:8px;border:0;color:inherit;cursor:pointer}
    .pageBtn.active{background:var(--accent);color:#042;font-weight:800}

    footer{padding:16px;text-align:center;color:var(--muted)}

    @media (max-width:600px){.thumb{height:96px}.controls{flex-direction:column;align-items:flex-start}.search{width:100%}}
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <div class="logo">GH</div>
      <div>
        <h1>Game Hub</h1>
        <div style="font-size:12px;color:var(--muted)">250 games • 12 categorieën • Speel direct</div>
      </div>
    </div>
    <div class="controls">
      <input id="search" class="search" placeholder="Zoek games... (titel of categorie)" />
      <select id="sort" class="search" style="min-width:160px">
        <option value="popular">Trending</option>
        <option value="newest">Nieuwste</option>
        <option value="alpha">A-Z</option>
      </select>
      <button id="clearBtn" class="btn">Reset</button>
    </div>
  </header>

  <div class="filters" id="filterBar"></div>

  <main>
    <div id="grid" class="grid"></div>
    <div class="pager" id="pager"></div>
  </main>

  <div id="viewer" class="viewer" role="dialog" aria-modal="true">
    <div class="viewer-frame">
      <div class="viewer-top">
        <div id="v-title">Spel</div>
        <div>
          <button id="openTab" class="close">Open in nieuw tabblad</button>
          <button id="close" class="close">Sluit</button>
        </div>
      </div>
      <iframe id="v-frame" class="viewer-iframe" src="about:blank"></iframe>
    </div>
  </div>

  <footer>Gemaakt door jou — klaar om gehost te worden op GitHub Pages of Netlify</footer>

  <script>
  // --- Data genereren: 250 games verdeeld over 12 categorieën ---
  const categories = [
    {id:'shooting', label:'Shooting'},
    {id:'racing', label:'Racing'},
    {id:'kids', label:'Kids'},
    {id:'puzzle', label:'Puzzle'},
    {id:'skill', label:'Skills'},
    {id:'strategy', label:'Strategy'},
    {id:'adventure', label:'Adventure'},
    {id:'sports', label:'Sports'},
    {id:'funny', label:'Funny'},
    {id:'arcade', label:'Arcade'},
    {id:'multiplayer', label:'Multiplayer'},
    {id:'classic', label:'Classic'}
  ];

  // Maak 250 games; in een echte site verbind je echte links naar je games
  const games = Array.from({length:250}, (_, i) => {
    const cat = categories[i % categories.length];
    const idx = i+1;
    return {
      id: 'g'+idx,
      title: `${cat.label} Game ${idx}`,
      thumb: `https://via.placeholder.com/640x380.png?text=${encodeURIComponent(cat.label+'+'+'Game+'+idx)}`,
      link: `games/${cat.id}${idx}/index.html`, // placeholder pad
      category: cat.id,
      categoryLabel: cat.label,
      date: new Date(Date.now() - (Math.floor(Math.random()*1000)*24*3600*1000)),
      popularity: Math.floor(Math.random()*1000)
    }
  });

  // --- UI en functionaliteit ---
  const grid = document.getElementById('grid');
  const filterBar = document.getElementById('filterBar');
  const searchInput = document.getElementById('search');
  const sortSelect = document.getElementById('sort');
  const pager = document.getElementById('pager');

  // pagina-instellingen
  const PER_PAGE = 24;
  let state = { q: '', category: 'all', page: 1, sort: 'popular' };

  // maak filterknoppen
  function renderFilters(){
    filterBar.innerHTML = '';
    const allChip = document.createElement('div'); allChip.className='chip' ; allChip.textContent='Alles';
    allChip.onclick = ()=>{state.category='all'; state.page=1; render();};
    filterBar.appendChild(allChip);
    categories.forEach(c=>{
      const d = document.createElement('div'); d.className='chip'; d.textContent = c.label; d.onclick = ()=>{ state.category = c.id; state.page=1; render(); };
      filterBar.appendChild(d);
    });
    updateActiveChips();
  }

  function updateActiveChips(){
    document.querySelectorAll('.chip').forEach(el=>el.classList.remove('active'));
    if(state.category==='all') document.querySelectorAll('.chip')[0].classList.add('active');
    else{
      const idx = categories.findIndex(c=>c.id===state.category);
      if(idx>=0) document.querySelectorAll('.chip')[idx+1].classList.add('active');
    }
  }

  // filter + sort + search logic
  function getFiltered(){
    let out = games.slice();
    if(state.category!=='all') out = out.filter(g=>g.category===state.category);
    if(state.q) {
      const q = state.q.toLowerCase();
      out = out.filter(g=> g.title.toLowerCase().includes(q) || g.categoryLabel.toLowerCase().includes(q));
    }
    if(state.sort==='popular') out.sort((a,b)=>b.popularity - a.popularity);
    if(state.sort==='newest') out.sort((a,b)=>b.date - a.date);
    if(state.sort==='alpha') out.sort((a,b)=>a.title.localeCompare(b.title));
    return out;
  }

  // render grid pagina
  function render(){
    updateActiveChips();
    const list = getFiltered();
    const total = list.length;
    const pages = Math.max(1, Math.ceil(total / PER_PAGE));
    if(state.page>pages) state.page = pages;
    const start = (state.page -1) * PER_PAGE;

    grid.innerHTML = '';
    const pageItems = list.slice(start, start + PER_PAGE);
    for(const g of pageItems){
      const card = document.createElement('div'); card.className='card';
      card.onclick = ()=> openViewer(g);
      const img = document.createElement('img'); img.className='thumb'; img.src = g.thumb; img.alt = g.title; img.loading='lazy';
      const t = document.createElement('div'); t.className='title'; t.textContent = g.title;
      const m = document.createElement('div'); m.className='meta'; m.textContent = `${g.categoryLabel} • ${g.popularity} plays`;
      card.appendChild(img); card.appendChild(t); card.appendChild(m);
      grid.appendChild(card);
    }

    // pager
    renderPager(pages, total);
  }

  function renderPager(pages, total){
    pager.innerHTML = '';
    const info = document.createElement('div'); info.style.marginRight='12px'; info.style.color='var(--muted)'; info.textContent = `${total} games gevonden`;
    pager.appendChild(info);

    // prev
    const prev = document.createElement('button'); prev.className='pageBtn'; prev.textContent='Prev'; prev.onclick = ()=>{ if(state.page>1){state.page--; render();} };
    pager.appendChild(prev);
    // pages (show up to 7)
    const from = Math.max(1, state.page-3); const to = Math.min(pages, from+6);
    for(let p=from;p<=to;p++){
      const b = document.createElement('button'); b.className='pageBtn' + (p===state.page? ' active':''); b.textContent = p; b.onclick = ()=>{ state.page = p; render(); };
      pager.appendChild(b);
    }
    const next = document.createElement('button'); next.className='pageBtn'; next.textContent='Next'; next.onclick = ()=>{ if(state.page<pages){state.page++; render();} };
    pager.appendChild(next);
  }

  // viewer
  const viewer = document.getElementById('viewer');
  const vframe = document.getElementById('v-frame');
  const vtitle = document.getElementById('v-title');
  document.getElementById('close').onclick = closeViewer;
  document.getElementById('openTab').onclick = ()=>{ window.open(vframe.src,'_blank'); };

  function openViewer(game){
    vtitle.textContent = game.title;
    // Als je echte HTML5 games host, plaats hier de echte link. Voor cross-origin kan iframe blokkeren.
    vframe.src = game.link;
    viewer.classList.add('show');
  }
  function closeViewer(){ viewer.classList.remove('show'); vframe.src = 'about:blank'; }

  // events
  searchInput.addEventListener('input', e=>{ state.q = e.target.value; state.page = 1; render(); });
  sortSelect.addEventListener('change', e=>{ state.sort = e.target.value; render(); });
  document.getElementById('clearBtn').addEventListener('click', ()=>{ state = { q:'', category:'all', page:1, sort:'popular' }; searchInput.value=''; sortSelect.value='popular'; render(); updateActiveChips(); });

  // keyboard esc to close
  window.addEventListener('keydown', e=>{ if(e.key==='Escape') closeViewer(); });

  // initial render
  renderFilters(); render();

  // Tips: Als je echte games wilt gebruiken, upload per game een map 'games/{category}{n}/index.html' met de HTML5-game.
  // Host de hele website op GitHub Pages of Netlify. Voor externe games (andere domeinen) kan de site problemen hebben met iframe embed (X-Frame-Options).
  </script>
</body>
</html>
